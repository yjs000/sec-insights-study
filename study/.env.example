# Stage 0~4는 OPENAI_API_KEY만 있으면 됩니다 (그마저도 대부분 Mock으로 대체 가능).
OPENAI_API_KEY=sk-your-key-here

# Stage 5~9: 실제 LLM/에이전트가 필요한 스테이지에서 어떤 프로바이더를 쓸지 선택.
#   openai (기본값) - 유료. 위 OPENAI_API_KEY 사용.
#   nvidia          - NVIDIA NIM(build.nvidia.com), 매달 무료 크레딧 제공.
LLM_PROVIDER=nvidia

# https://build.nvidia.com 에서 모델 하나를 열고 "Get API Key"로 발급.
NVIDIA_API_KEY=nvapi-your-key-here

# 필요하면 override (기본값은 study/llm_provider.py에 있음)
# NVIDIA_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5
# OPENAI_CHAT_MODEL=gpt-4o-mini
